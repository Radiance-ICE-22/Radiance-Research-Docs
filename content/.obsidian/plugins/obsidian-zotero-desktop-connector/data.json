{
  "database": "Zotero",
  "noteImportFolder": "Literature Notes",
  "pdfExportImageDPI": 120,
  "pdfExportImageFormat": "png",
  "pdfExportImageQuality": 90,
  "citeFormats": [
    {
      "name": "Markdown Citation",
      "format": "template",
      "template": "[@{{citekey}}]",
      "cslStyle": "apa"
    }
  ],
  "exportFormats": [
    {
      "name": "New Paper",
      "outputPathTemplate": "Papers/{{citekey}}.md",
      "imageOutputPathTemplate": "Assets/{{citekey}}/",
      "imageBaseNameTemplate": "image",
      "templatePath": "templates/Zotero Paper Template.md"
    }
  ],
  "citeSuggestTemplate": "[[{{citekey}}]]",
  "openNoteAfterImport": false,
  "whichNotesToOpenAfterImport": "first-imported-note"
}